# Copy to .env for local development. Never commit a real .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=measurex
POSTGRES_PASSWORD=measurex
POSTGRES_DB=measurex
POSTGRES_PORT=5432

# --- Redis (docker-compose) ---
REDIS_PORT=6379

# --- MinIO / object storage (docker-compose) ---
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- API (consumed from M0 onward) ---
DATABASE_URL=postgresql://measurex:measurex@localhost:5432/measurex?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-in-dev
JWT_REFRESH_SECRET=change-me-in-dev
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=12h

# --- Object storage (S3-compatible, private bucket, signed URLs) ---
# Local defaults target the docker-compose MinIO. Use real values in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=measurex-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Monitoring ---
SENTRY_DSN=
