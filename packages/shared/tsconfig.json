{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Emit CommonJS JS so the compiled NestJS API can require this package at
    // runtime (`node dist/main.js`). Types still resolve from src (see
    // package.json "types"), so consumers typecheck without a prebuilt dist.
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
