# MeasureX vision POC — environment overrides (copy to .env; .env is git-ignored).
# All checkpoint locations are configurable (CLAUDE.md "Model weights").
# Nothing here is required for the M0 scaffold / geometry tests.

# Directory holding downloaded model weights (not committed).
MEASUREX_VISION_WEIGHTS_DIR=./weights

# Per-model checkpoint paths (set once models are integrated in later milestones).
# MEASUREX_DEPTH_CHECKPOINT=./weights/depth_pro.pt
# MEASUREX_SAM2_CHECKPOINT=./weights/sam2.pt
# MEASUREX_GDINO_CHECKPOINT=./weights/grounding_dino.pth

# Where debug artifacts are written.
MEASUREX_VISION_OUTPUT_DIR=./outputs
