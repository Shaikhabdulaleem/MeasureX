<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.opengl.GLSurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Centre reticle the user points at the carton base. -->
    <View
        android:id="@+id/reticle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/reticle" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#88000000"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:text="@string/aim_then_tap" />

    <TextView
        android:id="@+id/instruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="76dp"
        android:background="#88000000"
        android:padding="12dp"
        android:textColor="#FFEB3B"
        android:textSize="16sp"
        android:text="@string/instr_set_target" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="#AA000000"
        android:padding="6dp">

        <Button
            android:id="@+id/set_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/set_target"
            android:textSize="11sp" />

        <Button
            android:id="@+id/export"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/export"
            android:textSize="11sp" />

        <Button
            android:id="@+id/new_sweep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/new_sweep"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
