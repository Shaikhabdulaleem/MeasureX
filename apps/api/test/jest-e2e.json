{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "\\.(e2e-spec|spec)\\.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^@measurex/shared$": "<rootDir>/../../packages/shared/src/index.ts"
  },
  "testTimeout": 30000
}
