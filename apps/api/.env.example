# apps/api local env. Copy to apps/api/.env (git-ignored).
DATABASE_URL=postgresql://measurex:measurex@localhost:5432/measurex?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=12h
PORT=3000
# Comma-separated origins allowed to call the API (web dashboard, etc.)
CORS_ORIGINS=http://localhost:3001

# Redis — enables the idle auto-complete scheduler (BullMQ). Leave unset to
# disable the scheduler (the auto-complete logic is still callable/tested).
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally; a Saudi-region bucket in prod).
# Private bucket — photos are only reached through signed URLs.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=measurex-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
